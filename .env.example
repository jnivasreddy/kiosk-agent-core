OPEN_ROUTER_API_KEY=replace_with_your_key
OPEN_ROUTER_MODEL=google/gemini-2.5-flash
# Optional local database path. runtime.py defaults to /tmp/kiosk-agentcore.sqlite3.
# KIOSK_DB_PATH=/tmp/my-demo-kiosk.sqlite3

# Streamlit connects to this local FastAPI backend.
KIOSK_API_URL=http://127.0.0.1:8080

# Optional shared conversation history; omit for local in-memory demo.
# REDIS_URL=redis://localhost:6379/0

# Cognito browser-login notebook (server-side configuration only).
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=replace_with_pool_id
COGNITO_CLIENT_ID=replace_with_client_id
COGNITO_CLIENT_SECRET=replace_with_client_secret_value
COGNITO_REDIRECT_URI=http://localhost:8000/auth/callback
